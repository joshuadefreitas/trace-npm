{
  "name": "trace-npm",
  "version": "0.1.0-alpha",
  "description": "See what an npm lifecycle script actually did: files touched, processes spawned, network endpoints contacted. Linux + strace.",
  "type": "module",
  "bin": {
    "trace-npm": "bin/trace-npm.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/trace-npm.js && node --check src/*.js"
  },
  "keywords": [
    "npm",
    "supply-chain",
    "postinstall",
    "install-scripts",
    "strace",
    "forensics",
    "security",
    "audit",
    "provenance",
    "syscall"
  ],
  "author": "Joshua de Freitas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghalvera/trace-npm.git"
  },
  "bugs": {
    "url": "https://github.com/Ghalvera/trace-npm/issues"
  },
  "homepage": "https://github.com/Ghalvera/trace-npm#readme",
  "engines": {
    "node": ">=20"
  }
}
